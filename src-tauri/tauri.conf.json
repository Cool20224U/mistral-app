{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mistral",
  "version": "1.0.0",
  "identifier": "com.cool20224u.mistral",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Mistral",
        "url": "https://chat.mistral.ai/chat",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "visible": false,
        "center": true,
        "decorations": true,
        "transparent": false
      },
      {
        "label": "launcher",
        "title": "Mistral Launcher",
        "url": "launcher.html",
        "width": 660,
        "height": 88,
        "resizable": false,
        "visible": false,
        "center": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false
      },
      {
        "label": "settings",
        "title": "Mistral Settings",
        "url": "settings.html",
        "width": 520,
        "height": 460,
        "resizable": false,
        "visible": false,
        "center": true,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://chat.mistral.ai https://*.mistral.ai; style-src 'self' 'unsafe-inline' https://chat.mistral.ai https://*.mistral.ai; connect-src 'self' https://chat.mistral.ai https://*.mistral.ai wss://*.mistral.ai https://*.posthog.com https://*.sentry.io; img-src 'self' data: blob: https: http:; font-src 'self' data: https:; frame-src https://chat.mistral.ai https://*.mistral.ai; child-src https://chat.mistral.ai https://*.mistral.ai;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Mistral AI Chat Desktop App",
    "longDescription": "A native desktop app for Mistral AI (Le Chat). Features a quick launcher accessible via Alt+Space (Windows) or Option+Space (macOS).",
    "macOS": {
      "minimumSystemVersion": "10.15",
      "exceptionDomain": "chat.mistral.ai"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
